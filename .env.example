BRAND_NAME=RAGForge
DATABASE_URL=sqlite:///./data/ragforge.db
STORAGE_DIR=./data/uploads
APP_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=20
MAX_EXTRACTED_CHARS=2000000
RATE_LIMIT_PER_MINUTE=60
EMBEDDING_PROVIDER=semantic
GENERATION_PROVIDER=extractive
EMBEDDING_DIMENSIONS=384
MODEL_CACHE_DIR=./data/models
MODEL_LOCAL_FILES_ONLY=false
EMBEDDING_THREADS=2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_SIZE=2048
EXPORT_DIR=./data/exports
EXPORT_MAX_SOURCE_MB=100
EXPORT_MAX_ARCHIVE_MB=80
EXPORT_STORAGE_MB=512
EXPORT_RETENTION_SECONDS=3600
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set a Responses API compatible model when enabling OpenAI generation.
OPENAI_MODEL=
# Docker Compose database password (change before any network exposure).
POSTGRES_PASSWORD=local-ragforge-change-me
