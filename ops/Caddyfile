{
	admin off
	auto_https disable_redirects
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$ALPHA_HOST:localhost} {
	tls internal
	# Keep localhost HTTP development ports usable alongside HTTPS QA.
	@pilot_host not host localhost 127.0.0.1
	header @pilot_host Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 21MB
	}
	reverse_proxy web:3000
}
